LEDGER_DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger
LEDGER_REDIS_URL=redis://localhost:6379/0
# row_lock (default) | serializable  -- ver DESIGN.md secao 4
LEDGER_LOCK_STRATEGY=row_lock
LEDGER_DB_POOL_SIZE=20
LEDGER_DB_MAX_OVERFLOW=40

# usado so pela suite de testes
LEDGER_TEST_DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5432/ledger_test
